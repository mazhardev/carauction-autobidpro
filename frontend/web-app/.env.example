# Copy to .env.local and fill in. Never commit real secrets.

# Required by NextAuth to encrypt/sign the session cookie.
AUTH_SECRET=

# Duende IdentityServer client used by NextAuth.
# The defaults below match the development client seeded by IdentityService.
ID_SERVER_CLIENT_ID=nextApp
ID_SERVER_CLIENT_SECRET=secret
ID_SERVER_ISSUER=http://localhost:5001

# YARP gateway. Server-side only (used by the fetch wrapper in server actions).
API_URL=http://localhost:6001/

# SignalR notification hub. Read by the browser, so it must be NEXT_PUBLIC_.
NEXT_PUBLIC_NOTIFY_URL=http://localhost:6001/notifications
